# Neon Postgres connection string (pooled)
DATABASE_URL=postgresql:

# At least 64 random characters. Generate: openssl rand -hex 48
SESSION_SECRET=
# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public URL of the site (used in emails, sitemap and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: password-reset emails via Resend (https://resend.com).
# If empty, the reset link is printed to the server console in development.
RESEND_API_KEY=

EMAIL_FROM="Aura Dial <no-reply@yourdomain.com>"
